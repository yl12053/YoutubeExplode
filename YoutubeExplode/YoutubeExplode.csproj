<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>14</LangVersion>
  </PropertyGroup>

  <PropertyGroup>
    <PackageIcon>favicon.png</PackageIcon>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(DuckovPath)$(SubPath)UniTask*">
      <Private>False</Private>
    </Reference>
    <None Include="../favicon.png" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Internalize="true" Version="1.7.0" />
    <PackageReference Include="Binternal" PrivateAssets="all" Version="1.0.2" />
    <PackageReference
      Include="JsonExtensions"
      Internalize="true"
      PrivateAssets="all"
      Version="1.2.3"
    />
    <PackageReference Include="Lazy.Fody" PrivateAssets="all" Version="1.11.0" />
    
    <PackageReference Include="PowerKit" PrivateAssets="all" Version="2.3.1" />
    <PackageReference Include="Snek" PrivateAssets="all" Version="1.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Using
      Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net9.0'))"
      Alias="Lock"
      Include="object"
    />
  </ItemGroup>
</Project>
